<Application x:Class="Winisland.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Winisland.Controls"
 xmlns:system="clr-namespace:System;assembly=mscorlib"
 ShutdownMode="OnExplicitShutdown">
 <Application.Resources>
  <FontFamily x:Key="UiFont">pack://application:,,,/Assets/Fonts/#Inter</FontFamily>
  <FontFamily x:Key="DisplayFont">pack://application:,,,/Assets/Fonts/#Inter Display</FontFamily>
  <system:Boolean x:Key="MotionEnabled">True</system:Boolean>
  <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
  <SolidColorBrush x:Key="Accent" Color="#B9EDAA"/>
  <SolidColorBrush x:Key="Muted" Color="#929295"/>
  <Style TargetType="TextBlock">
   <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
   <Setter Property="FontSize" Value="13"/>
  </Style>
  <Style x:Key="Glyph" TargetType="TextBlock">
   <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
   <Setter Property="FontSize" Value="17"/>
   <Setter Property="Foreground" Value="#F5F5F7"/>
   <Setter Property="HorizontalAlignment" Value="Center"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="IslandButton" TargetType="Button">
   <Setter Property="Foreground" Value="#E9E9EC"/>
   <Setter Property="Background" Value="#1D1D1F"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Padding" Value="14,8"/>
   <Setter Property="MinHeight" Value="38"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="Button">
     <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}" controls:InteractionMotion.Enabled="{DynamicResource MotionEnabled}">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#333336"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.65"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="Surface" Property="BorderThickness" Value="1"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.35"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource IslandButton}">
   <Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/>
   <Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource IslandButton}">
   <Setter Property="Background" Value="{StaticResource Accent}"/>
   <Setter Property="Foreground" Value="#15211A"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}" controls:InteractionMotion.Enabled="{DynamicResource MotionEnabled}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.85"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.65"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="White"/><Setter TargetName="Surface" Property="BorderThickness" Value="1"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="TabButton" TargetType="Button" BasedOn="{StaticResource IslandButton}">
   <Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="12,5"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="FontSize" Value="12"/>
  </Style>
  <Style TargetType="ToolTip">
   <Setter Property="Background" Value="#242427"/><Setter Property="Foreground" Value="White"/>
   <Setter Property="BorderBrush" Value="#414144"/><Setter Property="Padding" Value="9,5"/>
  </Style>
  <Style x:Key="IslandSlider" TargetType="Slider">
   <Setter Property="Foreground" Value="{StaticResource Accent}"/>
   <Setter Property="Height" Value="24"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
    <Grid VerticalAlignment="Center" Height="24">
     <Border Height="4" Background="#353538" CornerRadius="2" VerticalAlignment="Center"/>
     <Track x:Name="PART_Track" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
      <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate><Border Height="4" Background="{StaticResource Accent}" CornerRadius="2" VerticalAlignment="Center"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
      <Track.Thumb><Thumb Width="12" Height="24"><Thumb.Template><ControlTemplate><Ellipse Width="10" Height="10" Fill="White"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
      <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
     </Track>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Application.Resources>
</Application>

<UserControl x:Class="Winisland.Controls.OrganizerPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Winisland.Controls"
 Width="578" Height="280" Foreground="White" FontFamily="{StaticResource UiFont}"
 Loaded="OnLoaded" IsVisibleChanged="OnVisibilityChanged"
 GotKeyboardFocus="OnEditingFocusChanged" LostKeyboardFocus="OnEditingFocusChanged">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="NotchStyles.xaml"/></ResourceDictionary.MergedDictionaries>
   <SolidColorBrush x:Key="CalendarRed" Color="#FF453A"/>
   <Style x:Key="OrganizerInput" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/><Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#19191C"/>
    <Setter Property="BorderBrush" Value="#303033"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CaretBrush" Value="White"/><Setter Property="SelectionBrush" Value="#3A84FF"/>
    <Setter Property="Padding" Value="10,7"/><Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
     <Border x:Name="InputSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
      <ScrollViewer x:Name="PART_ContentHost"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="InputSurface" Property="BorderBrush" Value="{StaticResource ActivityBlue}"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
   <Style x:Key="DayButton" TargetType="Button" BasedOn="{StaticResource NotchButton}">
    <Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="0"/>
    <Setter Property="Height" Value="30"/><Setter Property="MinHeight" Value="30"/><Setter Property="Margin" Value="1,0"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
     <Border x:Name="DaySurface" Background="{TemplateBinding Background}" CornerRadius="10" controls:InteractionMotion.Enabled="{DynamicResource MotionEnabled}">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="DaySurface" Property="Opacity" Value="0.7"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="DaySurface" Property="Opacity" Value="0.45"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="DaySurface" Property="Opacity" Value="0"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
   <Style x:Key="ToolTab" TargetType="Button" BasedOn="{StaticResource NotchButton}">
    <Setter Property="Background" Value="Transparent"/><Setter Property="FontSize" Value="11"/>
    <Setter Property="Height" Value="32"/><Setter Property="Padding" Value="8,5"/><Setter Property="Margin" Value="2,0"/>
   </Style>
   <Style x:Key="ClockChoice" TargetType="ComboBox">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/><Setter Property="Foreground" Value="White"/>
    <Setter Property="Background" Value="#252528"/><Setter Property="FontSize" Value="11"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource NotchFocus}"/>
    <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem">
     <Setter Property="Foreground" Value="White"/><Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
     <Setter Property="Padding" Value="9,6"/><Setter Property="Background" Value="Transparent"/>
     <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ChoiceSurface" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ChoiceSurface" Property="Background" Value="#3A3A3E"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ChoiceSurface" Property="Background" Value="#224C60"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style></Setter.Value></Setter>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
     <Grid>
      <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="ChoiceButton" Background="#252528" CornerRadius="6"><Path Data="M1,1 L5,5 L9,1" Stroke="#8AFFFFFF" StrokeThickness="1.3" Width="7" Height="4" Stretch="Uniform" HorizontalAlignment="Right" Margin="0,0,7,0"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ChoiceButton" Property="Background" Value="#333338"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton>
      <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="7,0,21,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
      <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="None"><Border Background="#252528" BorderBrush="#45454A" BorderThickness="1" CornerRadius="9" Padding="4" MinWidth="145" Margin="0,4,0,0"><ScrollViewer MaxHeight="245" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel IsItemsHost="True"/></ScrollViewer></Border></Popup>
     </Grid>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
   <Style x:Key="ReminderCheck" TargetType="CheckBox">
    <Setter Property="Width" Value="32"/><Setter Property="Height" Value="34"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource NotchFocus}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
     <Grid Background="Transparent"><Ellipse x:Name="Circle" Width="17" Height="17" Stroke="#8A8A8E" StrokeThickness="1.4"/>
      <Path x:Name="Tick" Data="M3,8 L7,12 L15,3" Width="11" Height="10" Stretch="Uniform" Stroke="Black" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
     </Grid><ControlTemplate.Triggers>
      <Trigger Property="IsChecked" Value="True"><Setter TargetName="Circle" Property="Fill" Value="{StaticResource ActivityBlue}"/><Setter TargetName="Circle" Property="Stroke" Value="{StaticResource ActivityBlue}"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Circle" Property="Stroke" Value="White"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
   <Style x:Key="AllDayCheck" TargetType="CheckBox" BasedOn="{StaticResource ReminderCheck}">
    <Setter Property="Width" Value="90"/><Setter Property="Height" Value="28"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
     <Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Ellipse x:Name="Circle" Width="14" Height="14" Stroke="#8A8A8E" StrokeThickness="1.4"/>
      <Path x:Name="Tick" Data="M3,8 L7,12 L15,3" Width="9" Height="8" Stretch="Uniform" Stroke="Black" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
      <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
     </Grid><ControlTemplate.Triggers>
      <Trigger Property="IsChecked" Value="True"><Setter TargetName="Circle" Property="Fill" Value="#FF453A"/><Setter TargetName="Circle" Property="Stroke" Value="#FF453A"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Circle" Property="Stroke" Value="White"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
   <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="10"/><Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
     <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
      <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False"><RepeatButton.Template><ControlTemplate><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
      <Track.Thumb><Thumb><Thumb.Template><ControlTemplate><Border Width="4" Background="#444448" CornerRadius="2" HorizontalAlignment="Center"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
      <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False"><RepeatButton.Template><ControlTemplate><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
     </Track>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
  </ResourceDictionary>
 </UserControl.Resources>
 <Grid>
  <Grid x:Name="CalendarView">
   <Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition Width="22"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="22"/><RowDefinition Height="180"/><RowDefinition/></Grid.RowDefinitions>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="MonthLabel" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
     <StackPanel Grid.Column="1" Orientation="Horizontal">
      <Button x:Name="PreviousMonthButton" Style="{StaticResource NotchIconButton}" Click="OnPreviousMonth" ToolTip="Previous month" AutomationProperties.Name="Previous month"><Path Data="M14,5 L7,12 L14,19" Width="7" Height="12" Stretch="Uniform" Stroke="#8AFFFFFF" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Button>
      <Button x:Name="NextMonthButton" Style="{StaticResource NotchIconButton}" Click="OnNextMonth" ToolTip="Next month" AutomationProperties.Name="Next month"><Path Data="M7,5 L14,12 L7,19" Width="7" Height="12" Stretch="Uniform" Stroke="#8AFFFFFF" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Button>
     </StackPanel>
    </Grid>
    <UniformGrid x:Name="WeekdayLabels" Grid.Row="1" Columns="7"/>
    <UniformGrid x:Name="MonthDays" Grid.Row="2" Rows="6" Columns="7"/>
    <Grid Grid.Row="3" Margin="0,6,0,0">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="66"/><ColumnDefinition Width="66"/></Grid.ColumnDefinitions>
     <Button Content="Today" Style="{StaticResource NotchQuietButton}" HorizontalAlignment="Left" Foreground="{StaticResource CalendarRed}" Click="OnToday" AutomationProperties.Name="Go to today"/>
     <Button Grid.Column="1" Content="Import" Style="{StaticResource NotchQuietButton}" Click="OnImportCalendar" ToolTip="Import individual events from an .ics file" AutomationProperties.Name="Import calendar"/>
     <Button Grid.Column="2" Content="Export" Style="{StaticResource NotchQuietButton}" Click="OnExportCalendar" ToolTip="Export your local calendar as an .ics file" AutomationProperties.Name="Export calendar"/>
    </Grid>
   </Grid>
   <Grid Grid.Column="2">
    <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition/><RowDefinition Height="36"/></Grid.RowDefinitions>
    <Grid>
     <TextBlock x:Name="SelectedDateLabel" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
    </Grid>
    <Grid x:Name="AgendaView" Grid.Row="1">
     <Border x:Name="AgendaEmpty" CornerRadius="14" Background="#111113" Margin="0,2,0,7">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
       <Path Data="M4,6 H20 V21 H4 Z M4,10 H20 M8,3 V8 M16,3 V8" Stroke="#FF453A" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="25" Height="25" Stretch="Uniform" HorizontalAlignment="Center"/>
       <TextBlock Text="Nothing planned" FontSize="13" Margin="0,13,0,5" HorizontalAlignment="Center"/>
       <TextBlock Text="Add an event for this day" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Center"/>
      </StackPanel>
     </Border>
     <ScrollViewer x:Name="AgendaScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,2,0,5">
      <ItemsControl x:Name="AgendaItems"><ItemsControl.ItemTemplate><DataTemplate>
       <Border Background="#19191B" CornerRadius="12" Padding="10,8" Margin="0,0,0,6">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="3"/><ColumnDefinition/><ColumnDefinition Width="28"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
         <Border Background="#FF453A" CornerRadius="1.5"/>
         <StackPanel Grid.Column="1" Margin="9,0,4,0" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/><TextBlock Text="{Binding TimeLabel}" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel>
         <Button Grid.Column="2" Width="28" Style="{StaticResource NotchIconButton}" Tag="{Binding}" Click="OnEditEvent" ToolTip="Edit event" AutomationProperties.Name="Edit event"><Path Data="M4,17 L5,12 L16,1 L21,6 L10,17 Z M14,3 L19,8" Stroke="#8AFFFFFF" StrokeThickness="1.6" StrokeLineJoin="Round" Width="13" Height="13" Stretch="Uniform"/></Button>
         <Button Grid.Column="3" Width="28" Style="{StaticResource NotchIconButton}" Tag="{Binding}" Click="OnRemoveEvent" ToolTip="Remove event" AutomationProperties.Name="Remove event"><controls:NotchIcon Kind="Close" Width="12" Height="12" Foreground="{StaticResource Muted}"/></Button>
        </Grid>
       </Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </ScrollViewer>
    </Grid>
    <Grid x:Name="AgendaFooter" Grid.Row="2"><TextBlock Text="Local calendar" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center"/><Button x:Name="AgendaAddButton" Style="{StaticResource NotchButton}" Content="+  Add event" HorizontalAlignment="Right" Click="OnAddEvent" AutomationProperties.Name="Add calendar event"/></Grid>
    <Grid x:Name="EventEditor" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" Margin="0,2,0,0" PreviewKeyDown="OnEventEditorKeyDown">
     <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="42"/><RowDefinition Height="30"/><RowDefinition Height="65"/><RowDefinition/><RowDefinition Height="36"/></Grid.RowDefinitions>
     <Grid><TextBox x:Name="EventTitleBox" Style="{StaticResource OrganizerInput}" MaxLength="140" AutomationProperties.Name="Event title"/><TextBlock Text="Event title" FontSize="12" Foreground="{StaticResource Muted}" Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=EventTitleBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
     <Grid Grid.Row="1" Margin="0,8,0,3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox x:Name="EventTimeBox" Style="{StaticResource OrganizerInput}" MaxLength="5" ToolTip="Start time in 24-hour format, such as 14:30" AutomationProperties.Name="Event time"/><TextBox x:Name="EventDurationBox" Grid.Column="2" Style="{StaticResource OrganizerInput}" MaxLength="5" ToolTip="Duration in minutes" AutomationProperties.Name="Event duration in minutes"/></Grid>
     <Grid Grid.Row="2"><CheckBox x:Name="AllDayToggle" Style="{StaticResource AllDayCheck}" Content="All day" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Left" VerticalAlignment="Center" Checked="OnAllDayChanged" Unchecked="OnAllDayChanged" AutomationProperties.Name="All day event"/><TextBlock Text="Time / minutes" Foreground="{StaticResource Muted}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
     <Grid Grid.Row="3"><TextBox x:Name="EventNotesBox" Style="{StaticResource OrganizerInput}" MaxLength="10000" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" ToolTip="Optional event notes" AutomationProperties.Name="Event notes"/><TextBlock Text="Notes (optional)" FontSize="12" Foreground="{StaticResource Muted}" Margin="10,8" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=EventNotesBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
     <TextBlock x:Name="EventError" Grid.Row="4" FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource CalendarRed}" VerticalAlignment="Center"/>
     <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Style="{StaticResource NotchQuietButton}" Click="OnCancelEvent" AutomationProperties.Name="Cancel event edit"/><Button x:Name="EventSaveButton" Content="Save event" Style="{StaticResource NotchButton}" Background="#45201E" Margin="6,0,0,0" Click="OnSaveEvent" AutomationProperties.Name="Save event"/></StackPanel>
    </Grid>
   </Grid>
  </Grid>
  <Grid x:Name="ToolsView" Visibility="Collapsed">
   <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="10"/><RowDefinition/></Grid.RowDefinitions>
   <Border Background="#151517" CornerRadius="15" Padding="2,0">
    <UniformGrid Columns="5">
     <Button x:Name="NotesTool" Style="{StaticResource ToolTab}" Tag="notes" Click="OnToolClick" AutomationProperties.Name="Quick notes"><StackPanel Orientation="Horizontal"><Path Data="M4,3 H20 V21 H4 Z M8,8 H16 M8,12 H16 M8,16 H13" Width="13" Height="13" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Notes" FontSize="11" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel></Button>
     <Button x:Name="RemindersTool" Style="{StaticResource ToolTab}" Tag="reminders" Click="OnToolClick" AutomationProperties.Name="Reminders"><StackPanel Orientation="Horizontal"><controls:NotchIcon Kind="Check" Width="14" Height="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,5,0"/><TextBlock Text="Reminders" FontSize="11" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel></Button>
     <Button x:Name="ClocksTool" Style="{StaticResource ToolTab}" Tag="clocks" Click="OnToolClick" AutomationProperties.Name="World clocks"><StackPanel Orientation="Horizontal"><Path Data="M12,3 A9,9 0 1 1 11.99,3 M12,7 V12 L16,14" Width="14" Height="14" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Margin="0,0,5,0" VerticalAlignment="Center"/><TextBlock Text="Clocks" FontSize="11" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel></Button>
     <Button x:Name="StopwatchTool" Style="{StaticResource ToolTab}" Tag="stopwatch" Click="OnToolClick" AutomationProperties.Name="Stopwatch"><StackPanel Orientation="Horizontal"><controls:NotchIcon Kind="Timer" Width="14" Height="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,5,0"/><TextBlock Text="Stopwatch" FontSize="11" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel></Button>
     <Button x:Name="ShortcutsTool" Style="{StaticResource ToolTab}" Tag="shortcuts" Click="OnToolClick" AutomationProperties.Name="Quick shortcuts"><StackPanel Orientation="Horizontal"><Path Data="M5,5 H10 V10 H5 Z M15,5 H20 V10 H15 Z M5,15 H10 V20 H5 Z M15,15 H20 V20 H15 Z" Width="13" Height="13" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Margin="0,0,5,0" VerticalAlignment="Center"/><TextBlock Text="Shortcuts" FontSize="11" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel></Button>
    </UniformGrid>
   </Border>
   <Grid x:Name="NotesView" Grid.Row="2">
    <Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition/><RowDefinition Height="25"/></Grid.RowDefinitions>
    <TextBlock Text="A thought, before it slips away" Foreground="#FFD60A" FontSize="13" FontWeight="Medium"/>
    <TextBox x:Name="NotesBox" Grid.Row="1" Style="{StaticResource OrganizerInput}" FontSize="13" MaxLength="20000" AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Padding="12,10" TextChanged="OnNotesChanged" AutomationProperties.Name="Quick note"/>
    <Grid Grid.Row="2"><TextBlock x:Name="NotesSaveLabel" Text="Saved locally" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom"/><TextBlock x:Name="NotesCountLabel" FontSize="10" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Grid>
   </Grid>
   <Grid x:Name="RemindersView" Grid.Row="2" Visibility="Collapsed">
    <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition/><RowDefinition Height="80"/></Grid.RowDefinitions>
    <Grid><TextBlock Text="Reminders" Foreground="{StaticResource ActivityBlue}" FontWeight="Medium"/><TextBlock x:Name="ReminderCountLabel" FontSize="10" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/></Grid>
    <Grid Grid.Row="1"><TextBlock x:Name="RemindersEmpty" Text="Add a reminder and clear a little headspace." Foreground="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,5"><ItemsControl x:Name="ReminderItems"><ItemsControl.ItemTemplate><DataTemplate>
     <Border Background="#19191B" CornerRadius="10" Padding="4,3,5,3" Margin="0,0,0,5"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/><ColumnDefinition Width="30"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
      <CheckBox Style="{StaticResource ReminderCheck}" IsChecked="{Binding Completed, Mode=OneWay}" Tag="{Binding}" Click="OnReminderToggle" AutomationProperties.Name="Complete reminder"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0"><TextBlock Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Completed}" Value="True"><Setter Property="TextDecorations" Value="Strikethrough"/><Setter Property="Opacity" Value="0.45"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="{Binding DueLabel}" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel>
      <Button Grid.Column="2" Width="30" Style="{StaticResource NotchIconButton}" Tag="{Binding}" Click="OnEditReminder" ToolTip="Edit reminder" AutomationProperties.Name="Edit reminder"><Path Data="M4,17 L5,12 L16,1 L21,6 L10,17 Z M14,3 L19,8" Stroke="#8AFFFFFF" StrokeThickness="1.6" Width="12" Height="12" Stretch="Uniform"/></Button>
      <Button Grid.Column="3" Width="30" Style="{StaticResource NotchIconButton}" Tag="{Binding}" Click="OnRemoveReminder" ToolTip="Remove reminder" AutomationProperties.Name="Remove reminder"><controls:NotchIcon Kind="Close" Width="12" Height="12" Foreground="{StaticResource Muted}"/></Button>
     </Grid></Border>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Grid>
    <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="32"/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
     <Grid><TextBox x:Name="ReminderTitleBox" Style="{StaticResource OrganizerInput}" MaxLength="140" ToolTip="Reminder title" AutomationProperties.Name="Reminder title" PreviewKeyDown="OnReminderKeyDown"/><TextBlock Text="Add a reminder…" FontSize="12" Foreground="{StaticResource Muted}" Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=ReminderTitleBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
     <Button x:Name="ReminderSaveButton" Grid.Column="2" Content="Add" Style="{StaticResource NotchButton}" Background="#153138" Click="OnSaveReminder" AutomationProperties.Name="Save reminder"/>
     <Grid Grid.Row="1" Margin="0,4,0,0"><TextBox x:Name="ReminderDueBox" Style="{StaticResource OrganizerInput}" MaxLength="30" FontSize="11" Padding="10,4" ToolTip="Optional due time: 18:00, tomorrow 09:00, or 2027-03-12 14:30" AutomationProperties.Name="Reminder due time" PreviewKeyDown="OnReminderKeyDown"/><TextBlock Text="Due time (optional)" FontSize="11" Foreground="{StaticResource Muted}" Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=ReminderDueBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
     <Button x:Name="ReminderCancelButton" Grid.Row="1" Grid.Column="2" Content="Cancel" Visibility="Collapsed" Style="{StaticResource NotchQuietButton}" FontSize="11" Padding="5,3" Click="OnCancelReminder" AutomationProperties.Name="Cancel reminder edit"/>
     <TextBlock x:Name="ReminderError" Grid.Row="2" Grid.ColumnSpan="3" FontSize="10" Foreground="{StaticResource Muted}" Text="Due time is optional · try tomorrow 09:00" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis"/>
    </Grid>
   </Grid>
   <Grid x:Name="ClocksView" Grid.Row="2" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="20"/></Grid.RowDefinitions><UniformGrid x:Name="ClockCards" Rows="2" Columns="2"/><TextBlock Grid.Row="1" Text="Times follow each city's daylight-saving rules." FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom"/></Grid>
   <Grid x:Name="StopwatchView" Grid.Row="2" Visibility="Collapsed">
    <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center"><TextBlock Text="Stopwatch" Foreground="#BF8AF4" FontSize="13" FontWeight="Medium"/><TextBlock x:Name="StopwatchLabel" Text="00:00.00" FontFamily="{StaticResource DisplayFont}" FontSize="43" FontWeight="Light" Margin="0,12,0,14" Typography.NumeralAlignment="Tabular"/><StackPanel Orientation="Horizontal"><Button x:Name="StopwatchToggleButton" Content="Start" Style="{StaticResource NotchButton}" Background="#302039" Width="90" Click="OnStopwatchToggle" AutomationProperties.Name="Start stopwatch"/><Button x:Name="StopwatchLapButton" Content="Lap" IsEnabled="False" Style="{StaticResource NotchQuietButton}" Width="64" Margin="5,0" Click="OnStopwatchLap" AutomationProperties.Name="Record stopwatch lap"/><Button Content="Reset" Style="{StaticResource NotchQuietButton}" Width="66" Click="OnStopwatchReset" AutomationProperties.Name="Reset stopwatch"/></StackPanel></StackPanel>
    <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="LAPS" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock x:Name="LapsEmpty" Grid.Row="1" Text="Record a lap while running." FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Center"/><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="LapItems"><ItemsControl.ItemTemplate><DataTemplate><Grid Height="28"><Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{Binding Number, StringFormat=Lap {0}}" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding SplitLabel}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"/><TextBlock Grid.Column="2" Text="{Binding TotalLabel}" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Grid>
   </Grid>
   <Grid x:Name="ShortcutsView" Grid.Row="2" Visibility="Collapsed">
    <Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition/><RowDefinition Height="22"/></Grid.RowDefinitions><TextBlock Text="A few things, one click away" FontWeight="Medium" Foreground="{StaticResource ActivityBlue}"/>
    <UniformGrid Grid.Row="1" Rows="2" Columns="3">
     <Button Content="Downloads" Style="{StaticResource NotchButton}" Margin="3" Tag="downloads" Click="OnShortcut" AutomationProperties.Name="Open Downloads"/>
     <Button Content="Documents" Style="{StaticResource NotchButton}" Margin="3" Tag="documents" Click="OnShortcut" AutomationProperties.Name="Open Documents"/>
     <Button Content="Screenshot" Style="{StaticResource NotchButton}" Margin="3" Tag="screenshot" Click="OnShortcut" AutomationProperties.Name="Take a screenshot"/>
     <Button Content="Sound settings" Style="{StaticResource NotchButton}" Margin="3" Tag="sound" Click="OnShortcut" AutomationProperties.Name="Open sound settings"/>
     <Button Content="Network" Style="{StaticResource NotchButton}" Margin="3" Tag="network" Click="OnShortcut" AutomationProperties.Name="Open network settings"/>
     <Button Content="Task Manager" Style="{StaticResource NotchButton}" Margin="3" Tag="tasks" Click="OnShortcut" AutomationProperties.Name="Open Task Manager"/>
    </UniformGrid><TextBlock Grid.Row="2" Text="Opens the Windows tool you choose." FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom"/>
   </Grid>
  </Grid>
 </Grid>
</UserControl>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Winisland.Controls">
 <SolidColorBrush x:Key="Accent" Color="#FFFFFF"/>
 <!-- Apple's current dark system accent swatches; neutral fills are adapted
      for an opaque black housing rather than copied from iOS gray colors. -->
 <SolidColorBrush x:Key="SecondaryLabel" Color="#99FFFFFF"/>
 <SolidColorBrush x:Key="Muted" Color="#99FFFFFF"/>
 <SolidColorBrush x:Key="FocusOrange" Color="#FF9230"/>
 <SolidColorBrush x:Key="ActivityBlue" Color="#3CD3FE"/>
 <SolidColorBrush x:Key="KeyboardFocusBlue" Color="#0091FF"/>
 <SolidColorBrush x:Key="SystemGreen" Color="#30D158"/>
 <SolidColorBrush x:Key="ControlFill" Color="#262628"/>
 <SolidColorBrush x:Key="ControlHoverFill" Color="#38383A"/>
 <SolidColorBrush x:Key="ControlSelectedFill" Color="#303032"/>
 <SolidColorBrush x:Key="TrackFill" Color="#303032"/>
 <SolidColorBrush x:Key="ControlBorder" Color="#454548"/>
 <SolidColorBrush x:Key="Separator" Color="#33FFFFFF"/>
 <Style TargetType="TextBlock">
  <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
  <Setter Property="FontSize" Value="13"/>
  <Setter Property="Foreground" Value="White"/>
  <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
 </Style>
 <Style x:Key="NotchFocus" TargetType="Control">
  <Setter Property="Template"><Setter.Value><ControlTemplate>
   <Border BorderBrush="{StaticResource KeyboardFocusBlue}" BorderThickness="2" CornerRadius="12" Margin="1"/>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="NotchButton" TargetType="Button">
  <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
  <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="{StaticResource ControlFill}"/>
  <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,6"/>
  <Setter Property="MinHeight" Value="32"/><Setter Property="FontSize" Value="13"/>
  <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
  <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource NotchFocus}"/>
  <Setter Property="HorizontalContentAlignment" Value="Center"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}" controls:InteractionMotion.Enabled="{DynamicResource MotionEnabled}">
    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource ControlHoverFill}"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.65"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.28"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="NotchIconButton" TargetType="Button" BasedOn="{StaticResource NotchButton}">
  <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/>
  <Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/>
 </Style>
 <Style x:Key="NotchPlaybackButton" TargetType="Button" BasedOn="{StaticResource NotchIconButton}">
  <Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Grid Background="Transparent">
    <Border x:Name="Surface" Background="Transparent" CornerRadius="20" Margin="5" controls:InteractionMotion.Enabled="{DynamicResource MotionEnabled}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource ControlSelectedFill}"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.65"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.28"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="NotchPlayButton" TargetType="Button" BasedOn="{StaticResource NotchPlaybackButton}">
  <Setter Property="Width" Value="50"/>
 </Style>
 <Style x:Key="NotchQuietButton" TargetType="Button" BasedOn="{StaticResource NotchButton}">
  <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource Muted}"/>
  <Setter Property="Padding" Value="10,5"/>
 </Style>
 <Style x:Key="NotchTab" TargetType="RadioButton">
  <Setter Property="Width" Value="46"/><Setter Property="Height" Value="32"/>
  <Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Cursor" Value="Hand"/>
  <Setter Property="FocusVisualStyle" Value="{StaticResource NotchFocus}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
   <Grid Background="Transparent">
    <Border x:Name="Surface" Background="Transparent" Height="26" VerticalAlignment="Center" CornerRadius="13" controls:InteractionMotion.Enabled="{DynamicResource MotionEnabled}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource ControlSelectedFill}"/><Setter Property="Foreground" Value="White"/></Trigger>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource ControlHoverFill}"/><Setter Property="Foreground" Value="White"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.65"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.35"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="NotchProgressBar" TargetType="ProgressBar">
  <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="{StaticResource TrackFill}"/>
  <Setter Property="Height" Value="3"/><Setter Property="BorderThickness" Value="0"/>
  <Setter Property="controls:SmoothValue.Enabled" Value="True"/>
  <Setter Property="controls:SmoothValue.MotionEnabled" Value="{DynamicResource MotionEnabled}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
   <ProgressBar Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
    Value="{controls:SmoothValueBinding}"
    Foreground="{TemplateBinding Foreground}" Background="{TemplateBinding Background}" BorderThickness="0" IsHitTestVisible="False" Focusable="False">
    <ProgressBar.Template><ControlTemplate TargetType="ProgressBar">
     <Grid x:Name="PART_Track"><Border Background="{TemplateBinding Background}" CornerRadius="3"/>
      <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3" HorizontalAlignment="Left"/>
     </Grid>
    </ControlTemplate></ProgressBar.Template>
   </ProgressBar>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="ScrubSliderStyle" TargetType="controls:ScrubSlider">
  <Setter Property="Height" Value="40"/><Setter Property="Foreground" Value="White"/><Setter Property="Cursor" Value="Hand"/>
  <Setter Property="SmallChange" Value="1"/><Setter Property="LargeChange" Value="5"/>
  <Setter Property="FocusVisualStyle" Value="{StaticResource NotchFocus}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="controls:ScrubSlider">
   <Grid Height="{TemplateBinding Height}" Background="Transparent">
    <ProgressBar x:Name="Rail" Margin="10,0" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" Foreground="{TemplateBinding Foreground}" Height="5" VerticalAlignment="Center" IsHitTestVisible="False" Focusable="False">
     <ProgressBar.Template><ControlTemplate TargetType="ProgressBar">
      <Grid x:Name="PART_Track">
       <Border Background="{StaticResource TrackFill}" CornerRadius="4.5"/>
       <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="4.5" HorizontalAlignment="Left"/>
      </Grid>
     </ControlTemplate></ProgressBar.Template>
    </ProgressBar>
    <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
     <Track.DecreaseRepeatButton><RepeatButton Focusable="False"><RepeatButton.Template><ControlTemplate><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
     <Track.Thumb><Thumb Width="20" Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Slider}}"><Thumb.Template><ControlTemplate TargetType="Thumb">
      <Grid Background="Transparent"><Ellipse x:Name="Handle" Width="12" Height="12" Fill="White" Opacity="0"/></Grid>
      <ControlTemplate.Triggers>
       <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Slider}}" Value="True"><Setter TargetName="Handle" Property="Opacity" Value="1"/></DataTrigger>
       <DataTrigger Binding="{Binding IsMouseCaptureWithin, RelativeSource={RelativeSource AncestorType=Slider}}" Value="True"><Setter TargetName="Handle" Property="Opacity" Value="1"/></DataTrigger>
       <DataTrigger Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType=Slider}}" Value="True"><Setter TargetName="Handle" Property="Opacity" Value="1"/></DataTrigger>
      </ControlTemplate.Triggers>
     </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
     <Track.IncreaseRepeatButton><RepeatButton Focusable="False"><RepeatButton.Template><ControlTemplate><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
    </Track>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="controls:SmoothValue.Enabled" Value="True">
     <Setter TargetName="Rail" Property="Value" Value="{controls:SmoothValueBinding}"/>
     <Setter TargetName="PART_Track" Property="Value" Value="{controls:SmoothValueBinding}"/>
    </Trigger>
    <Trigger Property="IsMouseCaptureWithin" Value="True"><Setter TargetName="Rail" Property="Height" Value="9"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.28"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="VolumeSliderStyle" TargetType="controls:VolumeSlider" BasedOn="{StaticResource ScrubSliderStyle}">
  <Setter Property="controls:SmoothValue.Enabled" Value="True"/>
  <Setter Property="controls:SmoothValue.MotionEnabled" Value="{DynamicResource MotionEnabled}"/>
 </Style>
 <Style x:Key="NotchTimeEditor" TargetType="TextBox">
  <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/><Setter Property="FontSize" Value="44"/>
  <Setter Property="FontWeight" Value="Light"/><Setter Property="Foreground" Value="White"/>
  <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
  <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
  <Setter Property="Background" Value="Transparent"/><Setter Property="CaretBrush" Value="{StaticResource FocusOrange}"/>
  <Setter Property="SelectionBrush" Value="#80562B0E"/><Setter Property="BorderThickness" Value="1"/>
  <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Padding" Value="3,0"/>
  <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
   <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
    <ScrollViewer x:Name="PART_ContentHost" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#1C1710"/></Trigger>
    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Surface" Property="Background" Value="#21190F"/><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource FocusOrange}"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="ToolTip">
  <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="{StaticResource ControlFill}"/>
  <Setter Property="FontFamily" Value="{StaticResource UiFont}"/><Setter Property="FontSize" Value="11"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip">
   <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource ControlBorder}" BorderThickness="1" CornerRadius="8" Padding="9,6"><ContentPresenter/></Border>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>

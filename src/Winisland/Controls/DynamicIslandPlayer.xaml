<UserControl x:Class="Winisland.Controls.DynamicIslandPlayer"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Winisland.Controls"
 Height="{x:Static controls:DynamicIslandMetrics.ExpandedHeight}"
 FontFamily="{StaticResource UiFont}" Foreground="White"
 UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
 AutomationProperties.Name="Dynamic Island music player">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="NotchStyles.xaml"/>
   </ResourceDictionary.MergedDictionaries>
   <Style x:Key="IslandTransportButton" TargetType="Button" BasedOn="{StaticResource NotchPlaybackButton}">
    <Setter Property="Width" Value="52"/>
    <Setter Property="Height" Value="44"/>
   </Style>
   <Style x:Key="IslandMenuButton" TargetType="Button" BasedOn="{StaticResource NotchPlaybackButton}">
    <Setter Property="Width" Value="40"/>
    <Setter Property="Height" Value="44"/>
   </Style>
  </ResourceDictionary>
 </UserControl.Resources>
 <!-- The shared NotchSurface supplies the opaque housing. Keep the music
      hierarchy separate from the MacBook header and software feature tabs. -->
 <Grid Margin="20,16,20,10">
  <Grid.RowDefinitions>
   <RowDefinition Height="48"/>
   <RowDefinition Height="36"/>
   <RowDefinition Height="50"/>
  </Grid.RowDefinitions>
  <Grid>
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="48"/>
    <ColumnDefinition Width="12"/>
    <ColumnDefinition/>
    <ColumnDefinition Width="12"/>
    <ColumnDefinition Width="26"/>
   </Grid.ColumnDefinitions>
   <Border x:Name="ArtworkContainer"
    Width="{x:Static controls:DynamicIslandMetrics.ArtworkSize}"
    Height="{x:Static controls:DynamicIslandMetrics.ArtworkSize}"
    CornerRadius="8"
    Background="#262628">
    <Grid>
     <controls:NotchIcon x:Name="ArtworkPlaceholder" Kind="Music" Width="24" Height="24"
      Foreground="#99FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     <Image x:Name="AlbumArtwork" Stretch="UniformToFill">
      <Image.Clip><RectangleGeometry Rect="0,0,48,48" RadiusX="8" RadiusY="8"/></Image.Clip>
     </Image>
     <Border CornerRadius="8" BorderBrush="#14FFFFFF" BorderThickness="1" IsHitTestVisible="False"/>
    </Grid>
   </Border>
   <StackPanel Grid.Column="2" VerticalAlignment="Center">
    <TextBlock x:Name="TrackTitle" Text="Ready when you are" FontSize="15" FontWeight="SemiBold"
     TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    <TextBlock x:Name="TrackArtist" Text="Play music in your favorite app" FontSize="13" FontWeight="Medium"
     Foreground="#99FFFFFF" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
   </StackPanel>
   <controls:AudioBars x:Name="PlaybackBars" Grid.Column="4" Width="26" Height="22"
    Foreground="{DynamicResource ArtworkAccent}" VerticalAlignment="Center"
    UseLayoutRounding="False" SnapsToDevicePixels="False" IsHitTestVisible="False"/>
  </Grid>
  <Grid Grid.Row="1" Margin="0,2,0,0">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="34"/>
    <ColumnDefinition/>
    <ColumnDefinition Width="42"/>
   </Grid.ColumnDefinitions>
   <controls:ScrubSlider x:Name="SeekSlider" Grid.Column="1" Style="{StaticResource ScrubSliderStyle}"
    Height="22" VerticalAlignment="Center" Margin="-4,0" Minimum="0" Maximum="1" IsEnabled="False"
    AutomationProperties.Name="Dynamic Island playback position"
    AutomationProperties.HelpText="Drag to preview a time and release to seek. Scroll changes position by five seconds; Shift-scroll and arrow keys change it by one second."/>
   <TextBlock x:Name="ElapsedLabel" Text="0:00" FontSize="11" FontWeight="Medium" Foreground="#99FFFFFF"
    VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular" IsHitTestVisible="False"/>
   <TextBlock x:Name="RemainingLabel" Grid.Column="2" Text="−0:00" FontSize="11" FontWeight="Medium" Foreground="#99FFFFFF"
    VerticalAlignment="Center" TextAlignment="Right" TextTrimming="CharacterEllipsis"
    Typography.NumeralAlignment="Tabular" IsHitTestVisible="False"/>
  </Grid>
  <Grid Grid.Row="2">
   <Button x:Name="MenuButton" Style="{StaticResource IslandMenuButton}" HorizontalAlignment="Right"
    VerticalAlignment="Center" Margin="0,0,-7,0" Click="OnMenuClick" ToolTip="More Winisland controls"
    AutomationProperties.Name="Open Winisland controls">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Ellipse Width="3" Height="3" Fill="#99FFFFFF"/>
     <Ellipse Width="3" Height="3" Fill="#99FFFFFF" Margin="3,0"/>
     <Ellipse Width="3" Height="3" Fill="#99FFFFFF"/>
    </StackPanel>
   </Button>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
    <Button x:Name="PreviousButton" Style="{StaticResource IslandTransportButton}" IsEnabled="False"
     Click="OnPreviousClick" ToolTip="Previous track" AutomationProperties.Name="Previous track">
     <controls:NotchIcon Kind="Previous" Width="30" Height="26"/>
    </Button>
    <Button x:Name="PlayButton" Style="{StaticResource IslandTransportButton}" Width="64" IsEnabled="False"
     Click="OnPlayClick" ToolTip="Play or pause" AutomationProperties.Name="Play or pause">
     <controls:NotchIcon x:Name="PlayGlyph" Kind="Play" Width="29" Height="29"/>
    </Button>
    <Button x:Name="NextButton" Style="{StaticResource IslandTransportButton}" IsEnabled="False"
     Click="OnNextClick" ToolTip="Next track" AutomationProperties.Name="Next track">
     <controls:NotchIcon Kind="Next" Width="30" Height="26"/>
    </Button>
   </StackPanel>
  </Grid>
 </Grid>
</UserControl>

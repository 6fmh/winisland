<Window x:Class="Winisland.NotchWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Winisland.Controls"
 Width="700" Height="384" WindowStyle="None" ResizeMode="NoResize"
 AllowsTransparency="True" Background="Transparent" Topmost="True"
 ShowInTaskbar="False" ShowActivated="False" Title="Winisland notch"
 KeyDown="OnKeyDown" UseLayoutRounding="True" Foreground="White"
 FontFamily="{StaticResource UiFont}" TextOptions.TextFormattingMode="Ideal">
 <Window.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Controls/NotchStyles.xaml"/></ResourceDictionary.MergedDictionaries>
  <SolidColorBrush x:Key="ArtworkAccent" Color="#A0A0A5"/>
  <SolidColorBrush x:Key="UpdateError" Color="#FF6961"/>
  <Style x:Key="UpdateActionButton" TargetType="Button" BasedOn="{StaticResource NotchButton}">
   <Setter Property="MinHeight" Value="44"/><Setter Property="MinWidth" Value="84"/>
   <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Medium"/>
   <Setter Property="Padding" Value="16,0"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="Black"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="UpdateButtonSurface" Background="{TemplateBinding Background}" CornerRadius="22" Padding="{TemplateBinding Padding}" BorderBrush="Transparent" BorderThickness="2" controls:InteractionMotion.Enabled="{DynamicResource MotionEnabled}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="UpdateButtonSurface" Property="Opacity" Value="0.88"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="UpdateButtonSurface" Property="Opacity" Value="0.65"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="UpdateButtonSurface" Property="Opacity" Value="0.32"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="UpdateButtonSurface" Property="BorderBrush" Value="{StaticResource KeyboardFocusBlue}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="UpdateNotesScrollBar" TargetType="{x:Type ScrollBar}">
   <Setter Property="Width" Value="8"/><Setter Property="MinWidth" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Focusable" Value="False"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type ScrollBar}">
    <Grid Background="Transparent">
     <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}" IsDirectionReversed="True">
      <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False" IsTabStop="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
      <Track.Thumb><Thumb MinHeight="24" Focusable="False">
       <Thumb.Template><ControlTemplate TargetType="Thumb">
        <Border x:Name="UpdateScrollThumb" Background="#636366" CornerRadius="2" Margin="2,0"/>
        <ControlTemplate.Triggers>
         <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="UpdateScrollThumb" Property="Background" Value="#8E8E93"/></Trigger>
         <Trigger Property="IsDragging" Value="True"><Setter TargetName="UpdateScrollThumb" Property="Background" Value="#C7C7CC"/></Trigger>
        </ControlTemplate.Triggers>
       </ControlTemplate></Thumb.Template>
      </Thumb></Track.Thumb>
      <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False" IsTabStop="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
     </Track>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </ResourceDictionary></Window.Resources>
 <Grid>
  <Grid.RenderTransform><TranslateTransform x:Name="FullscreenOffset"/></Grid.RenderTransform>
  <Grid IsHitTestVisible="False" Opacity="{Binding Opacity, ElementName=Island}" Visibility="{Binding Visibility, ElementName=Island}">
   <controls:NotchSurface x:Name="ShadowSurface" Width="{Binding ActualWidth, ElementName=Island}" Height="{Binding ActualHeight, ElementName=Island}"
    Expansion="{Binding Expansion, ElementName=Surface}" IsDynamicIsland="{Binding IsDynamicIsland, ElementName=Surface}"
    Margin="{Binding Margin, ElementName=Island}" Opacity="{Binding Expansion, ElementName=Surface}" VerticalAlignment="Top" HorizontalAlignment="Center" UseLayoutRounding="False">
    <controls:NotchSurface.RenderTransform><TranslateTransform X="{Binding X, ElementName=IslandOffset}"/></controls:NotchSurface.RenderTransform>
    <controls:NotchSurface.Effect><DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="3" Opacity="0.5"/></controls:NotchSurface.Effect>
   </controls:NotchSurface>
  </Grid>
  <Grid x:Name="Island" Width="{x:Static controls:NotchMetrics.DefaultWidth}" Height="{x:Static controls:NotchMetrics.DefaultHeight}" VerticalAlignment="Top" HorizontalAlignment="Center" UseLayoutRounding="False"
   MouseEnter="OnIslandEnter" MouseLeave="OnIslandLeave" MouseLeftButtonDown="OnIslandClick" MouseDown="OnIslandMouseDown" MouseWheel="OnIslandWheel"
   AllowDrop="True" DragEnter="OnDragEnter" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnFilesDrop" SizeChanged="OnIslandSizeChanged" KeyboardNavigation.TabNavigation="Cycle">
   <Grid.RenderTransform><TranslateTransform x:Name="IslandOffset"/></Grid.RenderTransform>
   <controls:NotchSurface x:Name="Surface"/>
   <Path x:Name="DropHighlight" Stroke="#B064D2FF" StrokeThickness="1" Opacity="0" IsHitTestVisible="False"/>
   <Grid x:Name="CompactActivity" Margin="6,0" HorizontalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Grid x:Name="CompactLeftWing" Width="30">
     <Border x:Name="CompactArtworkFrame" Width="20" Height="20" CornerRadius="4" Background="#1C1C1E" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Grid>
       <controls:NotchIcon x:Name="CompactGlyph" Kind="Music" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       <Image x:Name="CompactArtwork" Stretch="UniformToFill"><Image.Clip><RectangleGeometry Rect="0,0,20,20" RadiusX="4" RadiusY="4"/></Image.Clip></Image>
      </Grid>
     </Border>
    </Grid>
    <Border x:Name="CompactCameraSpace" Grid.Column="1" Width="{x:Static controls:NotchMetrics.DefaultCameraWidth}" Background="Black"/>
    <Grid x:Name="CompactRightWing" Grid.Column="2" Width="30">
     <StackPanel x:Name="CompactIndicators" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
      <controls:AudioBars x:Name="CompactBars" Width="16" Height="12" Foreground="{DynamicResource ArtworkAccent}" Visibility="Collapsed" UseLayoutRounding="False" SnapsToDevicePixels="False"
       AutomationProperties.Name="Live audio spectrum: bass on the left, treble on the right"/>
      <TextBlock x:Name="CompactTimer" FontSize="11" FontWeight="Medium" Foreground="{StaticResource FocusOrange}" Margin="8,0,0,0" Visibility="Collapsed" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
      <TextBlock x:Name="CompactLabel" FontSize="11" FontWeight="Medium" Visibility="Collapsed" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
      <controls:NotchIcon x:Name="CompactPlaybackIcon" Kind="Pause" Width="13" Height="13" Visibility="Collapsed" VerticalAlignment="Center"/>
     </StackPanel>
     <ProgressBar x:Name="CompactUploadProgress" Style="{StaticResource NotchProgressBar}" Height="2" VerticalAlignment="Bottom" Margin="5,0,5,3" Maximum="100" Foreground="{StaticResource ActivityBlue}" Visibility="Collapsed"/>
    </Grid>
   </Grid>
   <Grid x:Name="Hud" Margin="24,8" Visibility="Collapsed" IsHitTestVisible="False">
    <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
    <controls:NotchIcon x:Name="HudGlyph" Kind="Speaker" Width="19" Height="19" VerticalAlignment="Center"/>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
     <TextBlock x:Name="HudTitle" FontSize="12" FontWeight="Medium" Visibility="Collapsed" Margin="0,0,0,6"/>
     <ProgressBar x:Name="HudProgress" Style="{StaticResource NotchProgressBar}" Height="4" Maximum="100"/>
    </StackPanel>
    <TextBlock x:Name="HudValue" Grid.Column="2" FontSize="12" FontWeight="Medium" TextAlignment="Right" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
   </Grid>
   <Grid x:Name="DeviceConnection" Margin="30,40,30,20" Visibility="Collapsed" Opacity="0" Background="Transparent" RenderTransformOrigin="0.5,0.5" AutomationProperties.LiveSetting="Polite">
    <Grid.RenderTransform><TransformGroup><ScaleTransform x:Name="DeviceConnectionScale"/><TranslateTransform x:Name="DeviceConnectionOffset"/></TransformGroup></Grid.RenderTransform>
    <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
    <controls:AppleDeviceGlyph x:Name="DeviceIllustration" Width="80" Height="64" VerticalAlignment="Center" IsHitTestVisible="False"/>
    <StackPanel Grid.Column="2" VerticalAlignment="Center">
     <TextBlock x:Name="DeviceName" Text="AirPods Pro" FontSize="16" LineHeight="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" ToolTipService.InitialShowDelay="400" ToolTipService.ShowDuration="4500"/>
     <Grid Margin="0,6,4,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Ellipse Width="5" Height="5" Fill="{StaticResource SystemGreen}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,7,0,0" IsHitTestVisible="False"/>
      <TextBlock x:Name="DeviceStatus" Grid.Column="1" Text="Connected" FontSize="13" LineHeight="18" MaxHeight="36" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="#C7C7CC" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
     </Grid>
    </StackPanel>
    <Button x:Name="DeviceDismissButton" Grid.Column="3" Width="44" Height="44" VerticalAlignment="Center"
     Style="{DynamicResource PopupDismissButton}" ToolTip="Dismiss connection" AutomationProperties.Name="Dismiss connection" Click="OnDeviceDismiss">
     <controls:NotchIcon Kind="Close" Width="12" Height="12" Foreground="#98989D"/>
    </Button>
   </Grid>
   <Grid x:Name="ExpandedContent" Width="578" Height="178" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed" Opacity="0" RenderTransformOrigin="0.5,0" UseLayoutRounding="True" KeyboardNavigation.TabNavigation="Continue">
    <Grid.RenderTransform><TransformGroup><ScaleTransform x:Name="ContentScale"/><TranslateTransform x:Name="ContentOffset"/></TransformGroup></Grid.RenderTransform>
    <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="8"/><RowDefinition/></Grid.RowDefinitions>
    <Grid x:Name="ExpandedHeader">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <RadioButton x:Name="MusicTab" GroupName="Activity" Style="{StaticResource NotchTab}" Checked="OnMusicTab" ToolTip="Now playing · Ctrl+1" AutomationProperties.Name="Now playing">
       <controls:NotchIcon Kind="Music" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
      </RadioButton>
      <RadioButton x:Name="FilesTab" GroupName="Activity" Style="{StaticResource NotchTab}" Checked="OnFilesTab" ToolTip="File shelf · Ctrl+2" AutomationProperties.Name="File shelf" Margin="2,0">
       <controls:NotchIcon Kind="Folder" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
      </RadioButton>
      <RadioButton x:Name="FocusTab" GroupName="Activity" Style="{StaticResource NotchTab}" Checked="OnFocusTab" ToolTip="Focus timer · Ctrl+3" AutomationProperties.Name="Focus timer">
       <controls:NotchIcon Kind="Timer" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
      </RadioButton>
      <RadioButton x:Name="CalendarTab" GroupName="Activity" Style="{StaticResource NotchTab}" Checked="OnCalendarTab" ToolTip="Calendar · Ctrl+4" AutomationProperties.Name="Calendar" Margin="2,0,0,0">
       <controls:NotchIcon Kind="Calendar" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
      </RadioButton>
      <RadioButton x:Name="UpdateTab" GroupName="Activity" Style="{StaticResource NotchTab}" Checked="OnUpdateTab" ToolTip="Software update · Ctrl+7" AutomationProperties.Name="Software update" Margin="2,0,0,0" Visibility="Collapsed">
       <Grid>
        <controls:NotchIcon Kind="Download" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
        <Ellipse x:Name="UpdateBadge" Width="5" Height="5" Fill="{StaticResource ActivityBlue}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-3,0" Visibility="Collapsed"/>
       </Grid>
      </RadioButton>
     </StackPanel>
     <Border x:Name="HeaderCameraSpace" Grid.Column="1" Width="{x:Static controls:NotchMetrics.DefaultCameraWidth}" Background="Black"/>
     <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <RadioButton x:Name="ToolsTab" GroupName="Activity" Style="{StaticResource NotchTab}" Checked="OnToolsTab" ToolTip="Notes, reminders, clocks and stopwatch · Ctrl+5" AutomationProperties.Name="Tools" Margin="0,0,4,0">
       <controls:NotchIcon Kind="Grid" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
      </RadioButton>
      <StackPanel x:Name="DeviceHeaderStatus" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,0,4,0" Background="Transparent" AutomationProperties.LiveSetting="Polite">
       <controls:AppleDeviceGlyph x:Name="DeviceHeaderIllustration" Width="24" Height="22"/>
       <TextBlock x:Name="DeviceHeaderLabel" Text="Connected" FontSize="10" MaxWidth="108" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Foreground="{StaticResource SystemGreen}" VerticalAlignment="Center" Margin="3,0,0,0"/>
      </StackPanel>
      <RadioButton x:Name="ControlCenterTab" GroupName="Activity" Style="{StaticResource NotchTab}" Checked="OnControlCenterTab" ToolTip="Control Center · Ctrl+6" AutomationProperties.Name="Control Center" Width="32" Margin="0,0,2,0">
       <controls:NotchIcon Kind="Controls" Width="17" Height="17" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
      </RadioButton>
      <StackPanel x:Name="BatteryStatus" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,0,12,0">
       <TextBlock x:Name="BatteryLabel" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
       <controls:NotchIcon x:Name="BatteryGlyph" Kind="Battery" Width="24" Height="16" Foreground="{StaticResource Muted}" Margin="6,0,0,0" VerticalAlignment="Center"/>
      </StackPanel>
      <Button x:Name="PinButton" Style="{StaticResource NotchIconButton}" ToolTip="Keep open" Click="OnPinClick" AutomationProperties.Name="Keep notch open">
       <controls:NotchIcon x:Name="PinGlyph" Kind="Pin" Width="14" Height="14" Foreground="{StaticResource Muted}"/>
      </Button>
      <Button x:Name="NotchSettingsButton" Style="{StaticResource NotchIconButton}" ToolTip="Settings" Click="OnSettingsClick" AutomationProperties.Name="Open settings">
       <controls:NotchIcon Kind="Settings" Width="17" Height="17"/>
      </Button>
     </StackPanel>
    </Grid>
    <Grid x:Name="MusicPanel" Grid.Row="2">
     <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Grid x:Name="ArtworkPresentation" Width="90" Height="90" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
      <Grid.RenderTransform><ScaleTransform x:Name="ArtworkScale"/></Grid.RenderTransform>
      <!-- Canvas lets the glow extend beyond the cover's layout slot. Fade the
           padded layer after blurring so its rectangular edges stay invisible. -->
      <Canvas IsHitTestVisible="False">
       <Grid x:Name="ArtworkGlow" Width="237" Height="246" Canvas.Left="-73.5" Canvas.Top="-78" Background="Transparent" Opacity="0">
        <Grid.OpacityMask><RadialGradientBrush><GradientStop Color="White" Offset="0.15"/><GradientStop Color="Transparent" Offset="1"/></RadialGradientBrush></Grid.OpacityMask>
        <Grid Background="Transparent">
         <Grid.Effect><BlurEffect Radius="40"/></Grid.Effect>
         <Image Source="{Binding Source, ElementName=AlbumArtwork}" Width="117" Height="126" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="UniformToFill" RenderTransformOrigin="0.5,0.5">
          <Image.RenderTransform><RotateTransform Angle="92"/></Image.RenderTransform>
         </Image>
        </Grid>
       </Grid>
      </Canvas>
      <Border Width="90" Height="90" CornerRadius="13" Background="#161618">
       <Grid>
        <Border x:Name="ArtworkPlaceholder" CornerRadius="13" Background="{StaticResource ControlFill}">
         <controls:NotchIcon Kind="Music" Width="32" Height="32" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <Image x:Name="AlbumArtwork" Stretch="UniformToFill"><Image.Clip><RectangleGeometry Rect="0,0,90,90" RadiusX="13" RadiusY="13"/></Image.Clip></Image>
        <Border CornerRadius="13" BorderBrush="#14FFFFFF" BorderThickness="1" IsHitTestVisible="False"/>
       </Grid>
      </Border>
     </Grid>
     <Grid x:Name="MusicPlaybackControls" Grid.Column="2">
      <Grid.RowDefinitions><RowDefinition Height="16"/><RowDefinition Height="16"/><RowDefinition Height="36"/><RowDefinition Height="38"/><RowDefinition Height="32"/></Grid.RowDefinitions>
      <TextBlock x:Name="TrackTitle" Text="No music playing" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
      <TextBlock x:Name="TrackArtist" Grid.Row="1" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource ArtworkAccent}" TextTrimming="CharacterEllipsis"/>
      <Grid Grid.Row="2">
       <controls:ScrubSlider x:Name="SeekSlider" Height="22" VerticalAlignment="Top" Style="{StaticResource ScrubSliderStyle}" Maximum="1" IsEnabled="False"
        AutomationProperties.Name="Playback position" AutomationProperties.HelpText="Click and drag to preview a time; release to seek. Scroll changes position by five seconds; Shift-scroll and arrow keys change it by one second."/>
       <TextBlock x:Name="ElapsedLabel" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="10,0" Typography.NumeralAlignment="Tabular" IsHitTestVisible="False"/>
       <TextBlock x:Name="DurationLabel" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="10,0" Typography.NumeralAlignment="Tabular" IsHitTestVisible="False"/>
      </Grid>
      <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
       <Button x:Name="PreviousButton" Style="{StaticResource NotchPlaybackButton}" IsEnabled="False" ToolTip="Previous track" Click="OnPreviousClick" AutomationProperties.Name="Previous track"><controls:NotchIcon Kind="Previous" Width="20" Height="17"/></Button>
       <Button x:Name="PlayButton" Style="{StaticResource NotchPlayButton}" IsEnabled="False" ToolTip="Play / pause" Click="OnPlayClick" AutomationProperties.Name="Play or pause"><controls:NotchIcon x:Name="PlayGlyph" Kind="Play" Width="23" Height="23"/></Button>
       <Button x:Name="NextButton" Style="{StaticResource NotchPlaybackButton}" IsEnabled="False" ToolTip="Next track" Click="OnNextClick" AutomationProperties.Name="Next track"><controls:NotchIcon Kind="Next" Width="20" Height="17"/></Button>
      </StackPanel>
      <Grid Grid.Row="4">
       <StackPanel x:Name="PlayerVolumeControls" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
       <Button x:Name="MuteButton" Style="{StaticResource NotchIconButton}" Click="OnMuteClick" IsEnabled="False" ToolTip="Mute player" AutomationProperties.Name="Mute player"><controls:NotchIcon x:Name="VolumeGlyph" Kind="Speaker" Width="15" Height="15" Foreground="{StaticResource Muted}"/></Button>
       <controls:VolumeSlider x:Name="VolumeSlider" Width="220" Height="32" Maximum="100" Value="0" IsEnabled="False" Style="{StaticResource VolumeSliderStyle}" Margin="4,0,0,0" ValueChanged="OnVolumeChanged"
        AutomationProperties.Name="Player volume" AutomationProperties.HelpText="Changes the player's own volume. Drag or click to set volume. Scroll changes it by two percent; Shift-scroll and arrow keys change it by one percent."/>
       <TextBlock x:Name="VolumeValue" Text="{Binding Value, ElementName=VolumeSlider, StringFormat={}{0:0}%}" FontSize="10" Foreground="{StaticResource Muted}" Width="36" Margin="6,0,0,0" VerticalAlignment="Center" TextAlignment="Right" Typography.NumeralAlignment="Tabular">
        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers>
         <DataTrigger Binding="{Binding IsEnabled, ElementName=VolumeSlider}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
        </Style.Triggers></Style></TextBlock.Style>
       </TextBlock>
       </StackPanel>
       <Button x:Name="PlayerConnectionHint" Content="Connect browser for player volume" Style="{StaticResource NotchQuietButton}" FontSize="11" Click="OnPlayerSetupClick" Visibility="Collapsed" HorizontalAlignment="Center" AutomationProperties.Name="Set up player volume"/>
      </Grid>
     </Grid>
     <StackPanel x:Name="MusicEmptyState" Grid.Column="2" VerticalAlignment="Center" Visibility="Collapsed">
      <TextBlock Text="Ready when you are" FontSize="14" FontWeight="SemiBold"/>
      <TextBlock Text="Play something in your favorite app.&#x0a;Your playback controls will appear here." FontSize="12" Foreground="{StaticResource Muted}" LineHeight="18" Margin="0,5,0,12"/>
      <StackPanel Orientation="Horizontal">
       <Button x:Name="MusicEmptyFocusButton" Style="{StaticResource NotchButton}" Click="OnFocusTab" AutomationProperties.Name="Open focus timer">
        <StackPanel Orientation="Horizontal"><controls:NotchIcon Kind="Timer" Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="Focus timer" FontSize="12"/></StackPanel>
       </Button>
       <Button x:Name="MusicEmptyFilesButton" Style="{StaticResource NotchQuietButton}" Click="OnFilesTab" Margin="8,0,0,0" AutomationProperties.Name="Open file shelf">
        <StackPanel Orientation="Horizontal"><controls:NotchIcon Kind="Folder" Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/><TextBlock Text="File shelf" FontSize="12" Foreground="{StaticResource Muted}"/></StackPanel>
       </Button>
      </StackPanel>
     </StackPanel>
    </Grid>
    <Grid x:Name="FilesPanel" Grid.Row="2" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="32"/></Grid.RowDefinitions>
     <Border x:Name="ShelfEmpty" Background="#101012" CornerRadius="16" Margin="0,4,0,4">
      <Grid>
       <Rectangle Stroke="#39393D" StrokeThickness="1" StrokeDashArray="4,4" RadiusX="16" RadiusY="16" Margin="1"/>
       <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <controls:NotchIcon Kind="Folder" Width="25" Height="25" Foreground="{StaticResource ActivityBlue}" HorizontalAlignment="Center"/>
        <TextBlock Text="Drop files here" FontSize="13" FontWeight="Medium" Margin="0,6,0,0" TextAlignment="Center"/>
        <TextBlock Text="A little shelf for whatever you're working on" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextAlignment="Center"/>
       </StackPanel>
      </Grid>
     </Border>
     <ScrollViewer x:Name="ShelfScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed" Margin="0,3,0,2">
      <ItemsControl x:Name="ShelfItems">
       <ItemsControl.ItemTemplate><DataTemplate>
        <Grid Margin="0,0,0,5">
         <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="32"/><ColumnDefinition Width="32"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
         <Button Style="{StaticResource NotchButton}" Padding="12,7" HorizontalContentAlignment="Stretch" Tag="{Binding}" Click="OnShelfOpen" PreviewMouseMove="OnShelfDrag" PreviewMouseLeftButtonDown="OnShelfDragStart" ToolTip="Open; drag to another app" AutomationProperties.Name="{Binding Name}">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/></Grid.ColumnDefinitions>
           <controls:NotchIcon Kind="File" Width="18" Height="18" Foreground="{StaticResource ActivityBlue}" VerticalAlignment="Center"/>
           <StackPanel Grid.Column="1">
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="13"/>
            <TextBlock Text="{Binding Status}" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"/>
            <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="2" Margin="0,5,0,0" Foreground="{StaticResource ActivityBlue}" Style="{StaticResource NotchProgressBar}" Visibility="{Binding IsUploading, Converter={StaticResource BoolVisibility}}"/>
           </StackPanel>
          </Grid>
          <Button.ContextMenu><ContextMenu>
           <MenuItem Header="Copy share link" Tag="{Binding}" Click="OnShelfCopy" IsEnabled="{Binding HasLink}"/>
           <MenuItem Header="Copy direct file link" Tag="{Binding}" Click="OnShelfCopyDirect" IsEnabled="{Binding HasDirectLink}"/>
           <MenuItem Header="Open uploaded file" Tag="{Binding}" Click="OnShelfOpenLink" IsEnabled="{Binding HasLink}"/>
           <Separator/><MenuItem Header="Show in Explorer" Tag="{Binding}" Click="OnShelfReveal"/>
          </ContextMenu></Button.ContextMenu>
         </Button>
         <Button Grid.Column="1" Style="{StaticResource NotchIconButton}" Tag="{Binding}" Click="OnShelfCopy" ToolTip="Copy share link" AutomationProperties.Name="Copy share link" Visibility="{Binding HasLink, Converter={StaticResource BoolVisibility}}"><controls:NotchIcon Kind="Copy" Width="14" Height="14"/></Button>
         <Button Grid.Column="2" Style="{StaticResource NotchIconButton}" Tag="{Binding}" Click="OnShelfRetry" ToolTip="Upload / retry" AutomationProperties.Name="Upload or retry file" Visibility="{Binding CanRetry, Converter={StaticResource BoolVisibility}}"><controls:NotchIcon Kind="Upload" Width="15" Height="15"/></Button>
         <Button Grid.Column="2" Style="{StaticResource NotchIconButton}" Tag="{Binding}" Click="OnShelfCancel" ToolTip="Cancel upload" AutomationProperties.Name="Cancel upload" Visibility="{Binding CanCancel, Converter={StaticResource BoolVisibility}}"><controls:NotchIcon Kind="Close" Width="14" Height="14"/></Button>
         <Button Grid.Column="3" Style="{StaticResource NotchIconButton}" Tag="{Binding}" Click="OnShelfRemove" ToolTip="Remove from shelf" AutomationProperties.Name="Remove file from shelf"><controls:NotchIcon Kind="Close" Width="12" Height="12" Foreground="{StaticResource Muted}"/></Button>
        </Grid>
       </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
     </ScrollViewer>
     <Grid Grid.Row="1">
      <Button x:Name="ShelfConnection" Content="Connect uploads" Style="{StaticResource NotchQuietButton}" FontSize="11" Click="OnUploadSettingsClick" HorizontalAlignment="Left" AutomationProperties.Name="Upload connection settings"/>
      <Button Style="{StaticResource NotchQuietButton}" HorizontalAlignment="Right" Click="OnAddFilesClick" AutomationProperties.Name="Add files to shelf"><StackPanel Orientation="Horizontal"><controls:NotchIcon Kind="Plus" Width="12" Height="12" Margin="0,0,6,0"/><TextBlock Text="Add files" FontSize="12"/></StackPanel></Button>
     </Grid>
    </Grid>
    <Grid x:Name="FocusPanel" Grid.Row="2" Visibility="Collapsed">
     <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="20"/><ColumnDefinition Width="218"/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Grid Width="90" Height="90" VerticalAlignment="Center">
      <controls:ActivityRing Progress="{Binding (controls:SmoothValue.DisplayValue), ElementName=FocusProgress}" Foreground="{StaticResource FocusOrange}"/>
      <controls:NotchIcon Kind="Timer" Width="32" Height="32" Foreground="{StaticResource FocusOrange}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Grid>
     <StackPanel Grid.Column="2" VerticalAlignment="Center">
      <TextBlock x:Name="FocusState" Text="Focus" FontSize="13" FontWeight="Medium" Foreground="{StaticResource FocusOrange}"/>
      <TextBox x:Name="TimerEditor" Text="25:00" Style="{StaticResource NotchTimeEditor}" Margin="-4,3,0,0" MaxLength="20" Typography.NumeralAlignment="Tabular"
       GotKeyboardFocus="OnTimerEditorGotFocus" LostKeyboardFocus="OnTimerEditorLostFocus" KeyDown="OnTimerEditorKeyDown" AutomationProperties.Name="Focus duration"
       AutomationProperties.HelpText="Type minutes, mm:ss, or h:mm:ss. Enter applies; Escape cancels."/>
      <TextBlock x:Name="TimerLabel" Visibility="Collapsed"/>
      <ProgressBar x:Name="FocusProgress" Style="{StaticResource NotchProgressBar}" Height="3" Maximum="100" Width="176" HorizontalAlignment="Left" Margin="0,6,0,0" Foreground="{StaticResource FocusOrange}"/>
      <TextBlock x:Name="FocusEditHint" Text="Click the time to set a duration" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"/>
     </StackPanel>
     <StackPanel Grid.Column="4" VerticalAlignment="Center">
      <TextBlock Text="MINUTES" FontSize="10" FontWeight="Medium" Foreground="{StaticResource Muted}" Margin="10,0,0,8"/>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
       <Button x:Name="Minutes5" Content="5" ToolTip="5 minutes · break" Tag="5" Style="{StaticResource NotchQuietButton}" Width="48" Click="OnDurationClick" AutomationProperties.Name="5 minute break"/>
       <Button x:Name="Minutes15" Content="15" ToolTip="15 minutes" Tag="15" Style="{StaticResource NotchQuietButton}" Width="48" Click="OnDurationClick" AutomationProperties.Name="15 minute focus session"/>
       <Button x:Name="Minutes25" Content="25" ToolTip="25 minutes" Tag="25" Style="{StaticResource NotchQuietButton}" Width="48" Click="OnDurationClick" AutomationProperties.Name="25 minute focus session" Margin="3,0"/>
       <Button x:Name="Minutes50" Content="50" ToolTip="50 minutes" Tag="50" Style="{StaticResource NotchQuietButton}" Width="48" Click="OnDurationClick" AutomationProperties.Name="50 minute focus session"/>
      </StackPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
       <Button x:Name="StartTimerButton" Content="Start" Style="{StaticResource NotchButton}" Click="OnStartTimerClick" AutomationProperties.Name="Start or pause focus timer" Background="#392A0E" Foreground="{StaticResource FocusOrange}"/>
       <Button Grid.Column="1" Style="{StaticResource NotchIconButton}" ToolTip="Reset timer" Click="OnResetTimerClick" AutomationProperties.Name="Reset timer"><controls:NotchIcon Kind="Reset" Width="16" Height="16"/></Button>
      </Grid>
     </StackPanel>
    </Grid>
    <Grid x:Name="UpdatePanel" Grid.Row="2" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid x:Name="UpdateHeader">
      <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <controls:NotchIcon x:Name="UpdateStateGlyph" Kind="Download" Width="36" Height="36" Foreground="{StaticResource ActivityBlue}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1">
       <TextBlock x:Name="UpdateTitle" Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
       <TextBlock x:Name="UpdateSubtitle" Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" Typography.NumeralAlignment="Tabular"/>
      </StackPanel>
      <Button x:Name="FullReleaseNotesButton" Grid.Column="2" Content="View release ↗" Style="{StaticResource NotchQuietButton}" MinHeight="44" FontSize="12" Padding="10,0" Margin="12,0,-10,0" Click="OnViewUpdateRelease" Visibility="{Binding HasUpdate, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="View full release notes on GitHub"/>
     </Grid>
     <Border x:Name="UpdateNotesSection" Grid.Row="1" BorderBrush="{StaticResource Separator}" BorderThickness="0,1,0,0" Padding="0,6,0,0" Margin="0,12,0,12" Visibility="{Binding HasUpdate, Converter={StaticResource BoolVisibility}}">
      <Grid>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBlock Text="What's new" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,8"/>
       <controls:ReleaseNotesView x:Name="UpdateNotes" Grid.Row="1" Markdown="{Binding Notes}" FontSize="13" Foreground="#D0D0D4" FocusVisualStyle="{StaticResource NotchFocus}" AutomationProperties.Name="Release notes" AutomationProperties.HelpText="Read or select the release notes. Use Page Down to continue; Tab moves to the update controls.">
        <controls:ReleaseNotesView.Resources><Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource UpdateNotesScrollBar}"/></controls:ReleaseNotesView.Resources>
       </controls:ReleaseNotesView>
       <TextBlock x:Name="UpdateNotesLimitHint" Grid.Row="2" Text="Showing a preview. View the release for the full notes." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="{Binding NotesTruncated, Converter={StaticResource BoolVisibility}}"/>
      </Grid>
     </Border>
     <TextBlock x:Name="UpdateEmptyState" Grid.Row="1" Text="{Binding EmptyStateDescription}" FontSize="13" Foreground="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="48,6,0,14">
      <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding HasUpdate}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
     </TextBlock>
     <Border x:Name="UpdateFooter" Grid.Row="2" BorderBrush="{StaticResource Separator}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
      <Grid>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="UpdateStatus" Text="{Binding Message}" FontSize="12" Foreground="{StaticResource Muted}" MinHeight="20" VerticalAlignment="Center" TextWrapping="Wrap" ToolTip="{Binding Message}" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding Message}"/>
        <TextBlock x:Name="UpdatePercentage" Grid.Column="1" Text="{Binding Progress, StringFormat={}{0:0}%}" FontSize="12" Foreground="{StaticResource ActivityBlue}" HorizontalAlignment="Right" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" Visibility="{Binding IsDownloading, Converter={StaticResource BoolVisibility}}"/>
       </Grid>
       <ProgressBar x:Name="UpdateProgress" Grid.Row="1" Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="4" Margin="0,8,0,0" Style="{StaticResource NotchProgressBar}" Foreground="{StaticResource ActivityBlue}" Visibility="{Binding IsDownloading, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="Update download progress"/>
       <Grid Grid.Row="2" Margin="0,12,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Button x:Name="CheckUpdatesButton" Content="{Binding CheckButtonLabel}" Click="OnCheckUpdates" IsEnabled="{Binding CanCheck}" MinWidth="164" HorizontalAlignment="Left" AutomationProperties.Name="Check for updates">
         <Button.Style><Style TargetType="Button" BasedOn="{StaticResource UpdateActionButton}">
          <Setter Property="Grid.Column" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource Muted}"/>
          <Style.Triggers><DataTrigger Binding="{Binding HasUpdate}" Value="False"><Setter Property="Grid.Column" Value="2"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="Black"/></DataTrigger></Style.Triggers>
         </Style></Button.Style>
        </Button>
        <Button x:Name="CancelUpdateButton" Grid.Column="1" Content="Cancel" Style="{StaticResource UpdateActionButton}" Background="{StaticResource ControlFill}" Foreground="White" Margin="0,0,8,0" Click="OnCancelUpdate" Visibility="{Binding CanCancel, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="Cancel update download"/>
        <Button x:Name="InstallUpdateButton" Grid.Column="2" Content="{Binding InstallButtonLabel}" Style="{StaticResource UpdateActionButton}" MinWidth="164" Click="OnInstallUpdate" IsEnabled="{Binding CanInstall}" Visibility="{Binding HasUpdate, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="Download update, install and restart Winisland"/>
       </Grid>
      </Grid>
     </Border>
    </Grid>
    <ContentControl x:Name="OrganizerHost" Grid.Row="2" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    <ContentControl x:Name="ControlCenterHost" Grid.Row="2" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    <controls:DynamicIslandPlayer x:Name="DynamicPlayer" Grid.RowSpan="3" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Top" Panel.ZIndex="1"/>
    <controls:DynamicIslandMenu x:Name="IslandMenuPanel" Grid.RowSpan="3" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Top" Panel.ZIndex="2"/>
   </Grid>
   <Rectangle x:Name="TopSeam" Height="1" Fill="Black" VerticalAlignment="Top" Margin="6,0" IsHitTestVisible="False"/>
  </Grid>
  <Button x:Name="MinimalActivity" Width="{x:Static controls:DynamicIslandMetrics.MinimalSize}" Height="{x:Static controls:DynamicIslandMetrics.MinimalSize}"
   HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed" Opacity="0" UseLayoutRounding="False"
   Cursor="Hand" Click="OnMinimalActivityClick" ToolTip="Focus timer" AutomationProperties.Name="Open focus timer">
   <Button.RenderTransform><TranslateTransform x:Name="MinimalOffset"/></Button.RenderTransform>
   <Button.Template><ControlTemplate TargetType="Button">
    <Border x:Name="MinimalSurface" Background="Black" CornerRadius="100" BorderThickness="0">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="MinimalSurface" Property="Background" Value="#171719"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="MinimalSurface" Property="Opacity" Value="0.8"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="MinimalSurface" Property="BorderBrush" Value="{StaticResource KeyboardFocusBlue}"/><Setter TargetName="MinimalSurface" Property="BorderThickness" Value="1.5"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Button.Template>
   <Grid>
    <controls:NotchIcon x:Name="MinimalGlyph" Kind="Timer" Width="18" Height="18" Foreground="{StaticResource FocusOrange}"/>
    <TextBlock x:Name="MinimalTimerLabel" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource FocusOrange}" Typography.NumeralAlignment="Tabular" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
   </Grid>
  </Button>
 </Grid>
</Window>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <StartupObject>Winisland.Program</StartupObject>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/Winisland.ico</ApplicationIcon>
    <AssemblyName>Winisland</AssemblyName>
    <Version>0.5.0</Version>
    <RepositoryUrl>https://github.com/6fmh/winisland</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Authors>6fmh</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>A quiet little space at the top of your Windows desktop.</Description>
  </PropertyGroup>
  <ItemGroup><Resource Include="Assets/Winisland.png" /></ItemGroup>
  <ItemGroup>
    <Resource Include="Assets/Fonts/*.ttf" />
    <None Include="../../LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" TargetPath="licenses/Winisland-LICENSE.txt" />
    <None Include="../../licenses/*.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" TargetPath="licenses/%(Filename)%(Extension)" />
    <None Update="Assets/Fonts/LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" TargetPath="licenses/Inter-LICENSE.txt" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Assets/BrowserExtension/**/*" />
    <Content Include="Assets/BrowserExtension/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" TargetPath="browser-extension/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup><PackageReference Include="NAudio.Wasapi" Version="2.3.0" /></ItemGroup>
  <ItemGroup><PackageReference Include="System.Management" Version="8.0.0" /></ItemGroup>
</Project>

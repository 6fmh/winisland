{
  "manifest_version": 3,
  "name": "Winisland Player Companion",
  "version": "0.4.0",
  "description": "Control the current website player's own volume from your Winisland notch. Local connection only.",
  "key": "",
  "permissions": ["nativeMessaging"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Winisland Player Companion", "default_popup": "popup.html" },
  "icons": { "32": "icon32.png", "128": "icon128.png" },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["player-main.js"], "run_at": "document_start", "all_frames": true, "match_about_blank": true, "world": "MAIN" },
    { "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_start", "all_frames": true, "match_about_blank": true, "world": "ISOLATED" }
  ]
}
